generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())

  items     Item[]
  recipes   Recipe[]
  mealPlans MealPlan[]
  posts     Post[]
  likes     Like[]
  comments  Comment[]
}

model Item {
  id         String   @id @default(cuid())
  userId     String
  name       String
  category   String?
  amount     String?
  imageUrl   String?
  expireDate DateTime
  notified   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  ingredients  String
  instructions String
  imageUrl     String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]
}

model MealPlan {
  id           String   @id @default(cuid())
  userId       String
  dayOfWeek    String
  mealType     String
  recipeTitle  String
  instructions String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  content   String
  imageUrls Json      @default("[]")
  recipes   Recipe[]  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}