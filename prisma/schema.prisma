generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  email     String?
  createdAt DateTime @default(now())

  items     Item[]
  recipes   Recipe[]
  mealPlans MealPlan[]
}

model Item {
  id         String   @id @default(cuid())
  userId     String
  name       String   
  category   String?  
  amount     String?  
  expireDate DateTime 
  notified   Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id           String   @id @default(cuid())
  userId       String
  title        String   
  description  String?  
  ingredients  String  
  instructions String   
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek String  
  mealType  String 
  recipeTitle String
  instructions String? 
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}